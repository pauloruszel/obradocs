{
  "expo": {
    "name": "Obradocs",
    "slug": "obradocs",
    "scheme": "obradocs",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0C5BAA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pauloruszel.obradocs",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.pauloruszel.obradocs"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorize o Obradocs a selecionar fotos e documentos da obra.",
          "cameraPermission": "Autorize o Obradocs a usar a câmera para registrar fotos da obra.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "baseUrl": "/obradocs"
    },
    "extra": {
      "eas": {
        "projectId": "65dda883-c9be-41e9-9cb2-801e9813241d"
      }
    },
    "owner": "pauloruszel"
  }
}
